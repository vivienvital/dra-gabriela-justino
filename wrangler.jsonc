{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dra-gabriela-justino",
  "account_id": "ad0acfa8d8d0b8ca5cb14514660e52e1",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "gabiinfecto.com.br", "custom_domain": true },
    { "pattern": "www.gabiinfecto.com.br", "custom_domain": true }
  ],
  // Copia só os arquivos do site pra dist/ (evita subir .git e configs)
  "build": {
    "command": "rm -rf dist && mkdir dist && cp -R index.html assets dist/"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
